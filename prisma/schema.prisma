  projectId          String?
  startDate          DateTime  @db.Date
  endDate            DateTime? @db.Date
  lastGeneratedMonth DateTime? @db.Date
  active             Boolean   @default(true)
}

// ----------------------------------------------------------------------------
// Controladoria
// ----------------------------------------------------------------------------

model AccountingPeriod {
  id             String    @id @default(cuid())
  organizationId String
  companyId      String
  month          DateTime  @db.Date
  status         String    @default("OPEN") // OPEN | CLOSED
  closedById     String?
  closedAt       DateTime? @db.Timestamptz(3)
  reopenedById   String?
  reopenedAt     DateTime? @db.Timestamptz(3)
  reopenReason   String?

  @@unique([organizationId, companyId, month])
}

// Razão gerencial. Toda linha identifica origem e regra; sem exclusão após fechamento.
model ManagerialEntry {
  id              String   @id @default(cuid())
  organizationId  String
  companyId       String
  competence      DateTime @db.Date
  accountId       String
  // Valor no sentido natural da conta (receita positiva = receita; custo positivo = custo)
  amount          Decimal  @db.Decimal(18, 2)
  costCenterId    String?
  businessUnitId  String?
  partyId         String?
  contractId      String?
  projectId       String?
  serviceId       String?
  professionalId  String?
  supplierPartyId String?
  sourceType      String // REVENUE_RECOGNITION | TIME_COST | LABOR_ABSORPTION | SUPPLIER_INVOICE | EXPENSE | PAYROLL_IMPORT | ALLOCATION | MANUAL_ADJUSTMENT | REVERSAL | DEDUCTION
  sourceId        String?
  ruleRef         String? // regra aplicada (ex.: allocationRuleId@versão, método de reconhecimento)
  description     String?
  reversalOfId    String?
  // Chave de idempotência da postagem (evita lançamento duplicado da mesma origem)
  dedupeKey       String?
  createdById     String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, competence])
  @@index([organizationId, projectId])
  @@index([organizationId, sourceType, sourceId])
}

model Budget {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  year           Int
  kind           String   @default("BUDGET") // BUDGET | FORECAST
  version        Int      @default(1)
  name           String
  status         String   @default("DRAFT") // DRAFT | APPROVED | SUPERSEDED
  basedOnId      String?
  approvedById   String?
  createdById    String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@unique([organizationId, companyId, year, kind, version])
}

model BudgetLine {
  id             String   @id @default(cuid())
  organizationId String
  budgetId       String
  accountId      String
  costCenterId   String?
  projectId      String?
  month          DateTime @db.Date
  amount         Decimal  @db.Decimal(18, 2)
}

model AllocationRule {
  id                 String    @id @default(cuid())
  organizationId     String
  companyId          String
  name               String
  version            Int       @default(1)
  sourceAccountId    String
  sourceCostCenterId String?
  basis              String // FIXED_PERCENT | HOURS | REVENUE
  // Para FIXED_PERCENT: [{ projectId?, costCenterId?, percent }]
  targets            Json
  targetAccountId    String
  validFrom          DateTime  @db.Date
  validTo            DateTime? @db.Date
  active             Boolean   @default(true)
  createdById        String
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
}

model AllocationRun {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  ruleId         String
  ruleVersion    Int
  competence     DateTime @db.Date
  sourceAmount   Decimal  @db.Decimal(18, 2)
  status         String   @default("POSTED") // POSTED | REVERSED
  createdById    String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
}

model PayrollImport {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  competence     DateTime @db.Date
  fileName       String?
  totalAmount    Decimal  @db.Decimal(18, 2)
  status         String   @default("POSTED") // POSTED | REVERSED
  createdById    String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
}

model PayrollImportLine {
  id             String  @id @default(cuid())
  organizationId String
  importId       String
  costCenterId   String?
  professionalId String?
  description    String
  amount         Decimal @db.Decimal(18, 2)
}

// Exportação de dados do cliente (LGPD/portabilidade/encerramento)
model DataExport {
  id             String    @id @default(cuid())
  organizationId String
  requestedById  String
  status         String    @default("PENDING") // PENDING | READY | FAILED
  storageKey     String?
  sizeBytes      Int?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  readyAt        DateTime? @db.Timestamptz(3)
}

// ----------------------------------------------------------------------------
// Estoque e produtos
// Custo médio móvel por produto e depósito. Movimentos são imutáveis (correção por estorno) e
// cronológicos por produto/depósito: um movimento não pode ter data anterior ao último já lançado.
// ----------------------------------------------------------------------------

model ProductCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@unique([organizationId, name])
}

model Product {
  id               String   @id @default(cuid())
  organizationId   String
  code             String
  name             String
  description      String?
  categoryId       String?
  kind             String   @default("GOODS") // GOODS (revenda) | MATERIAL (uso e consumo / aplicado em serviços) | FINISHED (produção própria)
  unit             String   @default("UN")
  barcode          String?
  // Classificação fiscal informada pela empresa (não validada pelo sistema)
  ncm              String?
  origin           String?
  salePrice        Decimal  @default(0) @db.Decimal(18, 4)
  lastCost         Decimal  @default(0) @db.Decimal(18, 6)
  minStock         Decimal  @default(0) @db.Decimal(14, 4)
  maxStock         Decimal? @db.Decimal(14, 4)
  tracksStock      Boolean  @default(true)
  revenueAccountId String?
  costAccountId    String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  @@unique([organizationId, code])
}

model Warehouse {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  code           String
  name           String
  allowNegative  Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@unique([organizationId, code])
}

// Saldo corrente por produto e depósito (mantido na mesma transação dos movimentos)
model StockBalance {
  id             String    @id @default(cuid())
  organizationId String
  companyId      String
  productId      String
  warehouseId    String
  quantity       Decimal   @default(0) @db.Decimal(14, 4)
  reserved       Decimal   @default(0) @db.Decimal(14, 4)
  avgCost        Decimal   @default(0) @db.Decimal(18, 6)
  value          Decimal   @default(0) @db.Decimal(18, 2)
  lastMovementAt DateTime? @db.Date
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([organizationId, productId, warehouseId])
}

model StockMovement {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  number         String
  productId      String
  warehouseId    String
  date           DateTime @db.Date
  // OPENING | PURCHASE_RECEIPT | PURCHASE_RETURN | SALE | SALE_RETURN | ADJUSTMENT_IN | ADJUSTMENT_OUT | COUNT_ADJUSTMENT | CONSUMPTION | TRANSFER_IN | TRANSFER_OUT | REVERSAL
  type           String
  quantity       Decimal  @db.Decimal(14, 4) // positivo = entrada; negativo = saída
  unitCost       Decimal  @db.Decimal(18, 6)
  totalCost      Decimal  @db.Decimal(18, 2) // mesmo sinal da quantidade
  balanceQty     Decimal  @db.Decimal(14, 4)
  balanceAvgCost Decimal  @db.Decimal(18, 6)
  balanceValue   Decimal  @db.Decimal(18, 2)
  sourceType     String? // GOODS_RECEIPT | SALE_ORDER | INVENTORY_COUNT | TRANSFER | MANUAL
  sourceId       String?
  projectId      String?
  costCenterId   String?
  partyId        String?
  reversalOfId   String?
  reason         String?
  idempotencyKey String
  createdById    String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, productId, warehouseId, date])
  @@index([organizationId, sourceType, sourceId])
}

// Inventário (contagem física): diferenças viram ajustes ao custo médio vigente
model InventoryCount {
  id             String    @id @default(cuid())
  organizationId String
  companyId      String
  warehouseId    String
  number         String
  date           DateTime  @db.Date
  status         String    @default("OPEN") // OPEN | POSTED | CANCELED
  notes          String?
  createdById    String
  postedById     String?
  postedAt       DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([organizationId, number])
}

model InventoryCountLine {
  id             String   @id @default(cuid())
  organizationId String
  countId        String
  productId      String
  systemQty      Decimal  @db.Decimal(14, 4)
  countedQty     Decimal? @db.Decimal(14, 4)
  movementId     String?

  @@unique([countId, productId])
}

// Pedido de venda de produtos: rascunho → confirmado (reserva) → entregue (baixa de estoque e títulos a receber)
model ProductOrder {
  id             String    @id @default(cuid())
  organizationId String
  companyId      String
  number         String
  partyId        String
  warehouseId    String
  orderDate      DateTime  @db.Date
  status         String    @default("DRAFT") // DRAFT | CONFIRMED | DELIVERED | CANCELED
  paymentTermId  String?
  productsAmount Decimal   @db.Decimal(18, 2)
  discountAmount Decimal   @default(0) @db.Decimal(18, 2)
  freightAmount  Decimal   @default(0) @db.Decimal(18, 2)
  totalAmount    Decimal   @db.Decimal(18, 2)
  costAmount     Decimal?  @db.Decimal(18, 2)
  customerPo     String?
  notes          String?
  deliveredAt    DateTime? @db.Date
  fiscalStatus   String    @default("NOT_REQUESTED") // NOT_REQUESTED | PENDING | AUTHORIZED | REJECTED | CANCELED
  cancelReason   String?
  createdById    String
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

model ProductOrderLine {
  id             String   @id @default(cuid())
  organizationId String
  orderId        String
  productId      String
  description    String
  quantity       Decimal  @db.Decimal(14, 4)
  unitPrice      Decimal  @db.Decimal(18, 4)
  discountAmount Decimal  @default(0) @db.Decimal(18, 2)
  amount         Decimal  @db.Decimal(18, 2)
  unitCost       Decimal? @db.Decimal(18, 6)
  costAmount     Decimal? @db.Decimal(18, 2)
}

// ----------------------------------------------------------------------------
// Cobrança bancária (boleto e PIX) e conciliação automática
// Emissão e baixa pelo provedor configurado (banco/gateway). Em desenvolvimento o provedor é SEMPRE simulado:
// nenhum boleto ou cobrança PIX real é registrado.
// ----------------------------------------------------------------------------

model BankCharge {
  id               String    @id @default(cuid())
  organizationId   String
  companyId        String
  number           String
  receivableId     String
  bankAccountId    String
  method           String // BOLETO | PIX
  provider         String
  environment      String // SIMULATED | SANDBOX | PRODUCTION
  idempotencyKey   String
  externalId       String?
  status           String    @default("PENDING") // PENDING | REGISTERED | PAID | CANCELED | EXPIRED | ERROR
  amount           Decimal   @db.Decimal(18, 2)
  dueDate          DateTime  @db.Date
  finePct          Decimal?  @db.Decimal(9, 4)
  interestPctMonth Decimal?  @db.Decimal(9, 4)
  digitableLine    String?
  pixCode          String?
  paymentUrl       String?
  paidAt           DateTime? @db.Date
  paidAmount       Decimal?  @db.Decimal(18, 2)
  settlementId     String?
  lastError        String?
  createdById      String
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([provider, externalId])
}

// Trilha de eventos da cobrança (registro, pagamento, baixa) — inclusive webhooks recebidos
model BankChargeEvent {
  id             String   @id @default(cuid())
  organizationId String
  chargeId       String
  type           String // REGISTERED | PAID | CANCELED | EXPIRED | ERROR | WEBHOOK_DUPLICATE
  payload        Json     @default("{}")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([organizationId, chargeId])
}

// Regras de conciliação automática: linha de extrato cuja descrição contém o texto vira lançamento (ex.: tarifas)
model ReconciliationRule {
  id             String   @id @default(cuid())
  organizationId String
  bankAccountId  String?
  name           String
  contains       String
  direction      String   @default("OUT") // IN | OUT
  description    String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
}

// Regra fiscal de produto (NF-e): INFORMADA E VALIDADA pelo responsável fiscal da empresa.
// O sistema não define CFOP, CST/CSOSN nem alíquotas; apenas aplica o que foi cadastrado e validado.
model FiscalProductRule {
  id             String    @id @default(cuid())
  organizationId String
  companyId      String
  name           String
  productId      String? // regra específica do produto; sem produto, vale para o NCM informado
  ncm            String?
  cfop           String
  icmsCst        String? // CST (regime normal) ou CSOSN (Simples Nacional), conforme o responsável fiscal
  icmsRatePct    Decimal?  @db.Decimal(9, 4)
  ipiCst         String?
  ipiRatePct     Decimal?  @db.Decimal(9, 4)
  pisCst         String?
  pisRatePct     Decimal?  @db.Decimal(9, 4)
  cofinsCst      String?
  cofinsRatePct  Decimal?  @db.Decimal(9, 4)
  notes          String?
  validFrom      DateTime  @db.Date
  validTo        DateTime? @db.Date
  validatedBy    String?
  validatedAt    DateTime? @db.Timestamptz(3)
  active         Boolean   @default(true)
  createdById    String
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@index([organizationId, companyId])
}
