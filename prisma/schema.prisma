model HourBankEntry {
  id             String    @id @default(cuid())
  organizationId String
  contractId     String
  month          DateTime  @db.Date
  kind           String // CREDIT | DEBIT | EXPIRE | ADJUST | OVERAGE
  hours          Decimal   @db.Decimal(12, 2) // positivo = crédito, negativo = débito
  creditEntryId  String? // débito/expiração consome este crédito (ordem FIFO)
  expiresOn      DateTime? @db.Date
  sourceType     String? // TIME_ENTRY | MONTHLY_FRANCHISE | PREPAID_PURCHASE | MANUAL | EXPIRY_RUN
  sourceId       String?
  notes          String?
  createdById    String?
  // Excedente: PENDING (aguarda decisão) | APPROVED (cobrável) | WAIVED (abonado) | ABSORBED (política BLOCK: não cobrável)
  overageStatus  String?
  decidedById    String?
  decidedAt      DateTime? @db.Timestamptz(3)
  decisionNote   String?
  // Chave de idempotência (ex.: "TIME_ENTRY:<id>:<creditId>")
  dedupeKey      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([organizationId, dedupeKey])
  @@index([contractId, month])
}

