// =============================================================================
// 242ERP — Modelo de dados
// Convenções:
//  * Toda tabela empresarial possui organizationId (isolamento de tenant).
//  * Tabelas com companyId respeitam o escopo de empresa do usuário.
//  * Valores monetários: Decimal(18,2). Quantidades/horas: Decimal(12,2).
//    Tarifas/custos unitários: Decimal(18,4). Percentuais: Decimal(9,4).
//  * Datas civis (vencimento, competência, data do apontamento): @db.Date.
//    Instantes (criação, aprovação, SLA): timestamptz (UTC).
//  * Lançamentos efetivados não são apagados: estorno via registro inverso.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Plataforma SaaS
// ----------------------------------------------------------------------------

enum OrgStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

model Plan {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String?
  priceMonthly Decimal  @db.Decimal(18, 2)
  currency     String   @default("BRL")
  maxUsers     Int
  maxCompanies Int
  maxStorageMb Int
  modules      String[]
  features     String[]
  trialDays    Int      @default(14)
  rank         Int      @default(0)
  isPublic     Boolean  @default(true)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  organizations Organization[]
  subscriptions Subscription[]
}

model Organization {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  status           OrgStatus @default(TRIAL)
  planId           String
  plan             Plan      @relation(fields: [planId], references: [id])
  trialEndsAt      DateTime? @db.Timestamptz(3)
  timezone         String    @default("America/Sao_Paulo")
  currency         String    @default("BRL")
  locale           String    @default("pt-BR")
  storageUsedBytes BigInt    @default(0)
  suspendedAt      DateTime? @db.Timestamptz(3)
  canceledAt       DateTime? @db.Timestamptz(3)
  retentionUntil   DateTime? @db.Timestamptz(3)
  onboardingDone   Boolean   @default(false)
  // Setor de atividade (perfil de partida e terminologia; ver src/domain/sectors.ts)
  sector           String    @default("CONSULTING_IT")
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  memberships  Membership[]
  subscription Subscription?
  planChanges  PlanChange[]

  @@index([status])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

model Subscription {
  id                     String             @id @default(cuid())
  organizationId         String             @unique
  organization           Organization       @relation(fields: [organizationId], references: [id])
  planId                 String
  plan                   Plan               @relation(fields: [planId], references: [id])
  status                 SubscriptionStatus @default(TRIALING)
  provider               String             @default("simulated")
  providerCustomerId     String?
  providerSubscriptionId String?
  currentPeriodStart     DateTime?          @db.Timestamptz(3)
  currentPeriodEnd       DateTime?          @db.Timestamptz(3)
  pastDueSince           DateTime?          @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean            @default(false)
  pendingPlanId          String?
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(3)

  invoices SaasInvoice[]
}

// Faturamento da assinatura SaaS (separado do faturamento de serviços das consultorias)
model SaasInvoice {
  id                String       @id @default(cuid())
  subscriptionId    String
  subscription      Subscription @relation(fields: [subscriptionId], references: [id])
  organizationId    String
  providerInvoiceId String?      @unique
  amount            Decimal      @db.Decimal(18, 2)
  currency          String       @default("BRL")
  periodStart       DateTime     @db.Timestamptz(3)
  periodEnd         DateTime     @db.Timestamptz(3)
  status            String // OPEN | PAID | FAILED | VOID
  paidAt            DateTime?    @db.Timestamptz(3)
  failureReason     String?
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)

  @@index([organizationId])
}

model PlanChange {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  fromPlanId     String?
  toPlanId       String
  kind           String // UPGRADE | DOWNGRADE | INITIAL | CANCEL | REACTIVATE
  effectiveAt    DateTime     @db.Timestamptz(3)
  requestedById  String?
  reason         String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([organizationId])
}

// Idempotência de webhooks (assinatura SaaS, fiscal, bancos)
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  type        String
  payload     Json
  receivedAt  DateTime  @default(now()) @db.Timestamptz(3)
  processedAt DateTime? @db.Timestamptz(3)
  error       String?

  @@unique([provider, eventId])
}

// ----------------------------------------------------------------------------
// Identidade, sessões e acesso
// ----------------------------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String
  isPlatformAdmin Boolean   @default(false)
  mfaSecret       String?
  mfaEnabled      Boolean   @default(false)
  failedLogins    Int       @default(0)
  lockedUntil     DateTime? @db.Timestamptz(3)
  lastLoginAt     DateTime? @db.Timestamptz(3)
  active          Boolean   @default(true)
  preferences     Json      @default("{}")
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  memberships Membership[]
  sessions    Session[]
}

model Session {
  id             String   @id @default(cuid())
  tokenHash      String   @unique
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  mfaPending     Boolean  @default(false)
  supportGrantId String?
  ip             String?
  userAgent      String?
  expiresAt      DateTime @db.Timestamptz(3)
  lastSeenAt     DateTime @default(now()) @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
}

enum MembershipKind {
  INTERNAL
  CLIENT
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  kind           MembershipKind @default(INTERNAL)
  // Para usuários de portal do cliente: parte (cliente) autorizada
  partyId        String?
  // Profissional vinculado ao usuário (portal do consultor/apontamentos)
  professionalId String?
  allCompanies   Boolean        @default(true)
  companyIds     String[]
  roleIds        String[]
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  name           String
  description    String?
  permissions    String[]
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@unique([organizationId, key])
}

model Invitation {
  id             String         @id @default(cuid())
  organizationId String
  email          String
  roleIds        String[]
  kind           MembershipKind @default(INTERNAL)
  partyId        String?
  allCompanies   Boolean        @default(true)
  companyIds     String[]
  tokenHash      String         @unique
  invitedById    String
  expiresAt      DateTime       @db.Timestamptz(3)
  acceptedAt     DateTime?      @db.Timestamptz(3)
  revokedAt      DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  @@index([organizationId])
}

// Acesso de suporte da plataforma: autorizado pela organização, temporário e auditado
model SupportAccessGrant {
  id             String    @id @default(cuid())
  organizationId String
  platformUserId String
  grantedById    String
  reason         String
  expiresAt      DateTime  @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  companyId      String?
  userId         String?
  actorLabel     String?
  action         String
  entity         String
  entityId       String?
  changes        Json?
  reason         String?
  correlationId  String?
  ip             String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@index([organizationId, entity, entityId])
}

model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime @db.Timestamptz(3)
}

// Fila simples de tarefas em segundo plano (FOR UPDATE SKIP LOCKED)
model Job {
  id             String    @id @default(cuid())
  organizationId String?
  type           String
  payload        Json
  status         String    @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  runAt          DateTime  @default(now()) @db.Timestamptz(3)
  lockedAt       DateTime? @db.Timestamptz(3)
  lastError      String?
  result         Json?
  uniqueKey      String?   @unique
  createdById    String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt     DateTime? @db.Timestamptz(3)

  @@index([status, runAt])
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  title          String
  body           String?
  link           String?
  readAt         DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  @@index([organizationId, userId, readAt])
}

// Caixa de saída de mensagens: em desenvolvimento o provedor é simulado (nada é enviado)
model OutboundMessage {
  id             String    @id @default(cuid())
  organizationId String?
  channel        String // EMAIL | TEAMS | ...
  to             String
  subject        String
  body           String
  provider       String
  status         String    @default("QUEUED") // QUEUED | SENT | SIMULATED | FAILED
  error          String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  sentAt         DateTime? @db.Timestamptz(3)
}

model Attachment {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String?
  entity         String
  entityId       String
  fileName       String
  mimeType       String
  sizeBytes      Int
  sha256         String
  storageKey     String
  visibility     String   @default("INTERNAL") // INTERNAL | CLIENT | RESTRICTED
  uploadedById   String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([organizationId, entity, entityId])
}

model SavedFilter {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  screen         String
  name           String
  query          String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([organizationId, userId, screen])
}

model Favorite {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  label          String
  href           String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@unique([organizationId, userId, href])
}

// ----------------------------------------------------------------------------
// Estrutura organizacional e configuração
// ----------------------------------------------------------------------------

model Company {
  id                    String   @id @default(cuid())
  organizationId        String
  kind                  String   @default("HEADQUARTERS") // HEADQUARTERS | BRANCH
  parentId              String?
  legalName             String
  tradeName             String?
  cnpj                  String
  stateRegistration     String?
  municipalRegistration String?
  taxRegime             String? // informado pelo usuário (ex.: Simples Nacional, Lucro Presumido)
  email                 String?
  phone                 String?
  address               Json     @default("{}")
  municipalityCode      String?
  currency              String   @default("BRL")
  timezone              String   @default("America/Sao_Paulo")
  logoAttachmentId      String?
  responsibleName       String?
  responsibleEmail      String?
  active                Boolean  @default(true)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  @@unique([organizationId, cnpj])
}

model BusinessUnit {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  code           String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@unique([organizationId, code])
}

model CostCenter {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String?
  code           String
  name           String
  kind           String   @default("OPERATIONAL") // OPERATIONAL | ADMINISTRATIVE | COMMERCIAL
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@unique([organizationId, code])
}

model BankAccount {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  name           String
  bankCode       String?
  agency         String?
  accountNumber  String?
  openingBalance Decimal  @db.Decimal(18, 2)
  openingDate    DateTime @db.Date
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
}

model OnboardingState {
  id             String    @id @default(cuid())
  organizationId String    @unique
  step           Int       @default(1)
  data           Json      @default("{}")
  completedAt    DateTime? @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
}

model DocumentSequence {
  id             String @id @default(cuid())
  organizationId String
  companyId      String @default("")
  docType        String
  prefix         String
  nextNumber     Int    @default(1)
  padding        Int    @default(5)

  @@unique([organizationId, companyId, docType])
}

model OrgSetting {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  value          Json
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@unique([organizationId, key])
}

model WorkCalendar {
  id                  String    @id @default(cuid())
  organizationId      String
  name                String
  // Horas por dia da semana [dom, seg, ter, qua, qui, sex, sab]
  weeklyHours         Decimal[] @db.Decimal(5, 2)
  timezone            String    @default("America/Sao_Paulo")
  // Janela de atendimento (para SLA), minutos desde 00:00
  businessStartMinute Int       @default(540)
  businessEndMinute   Int       @default(1080)
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
}

model Holiday {
  id             String   @id @default(cuid())
  organizationId String
  calendarId     String
  date           DateTime @db.Date
  name           String

  @@unique([calendarId, date])
}

model Service {
  id               String   @id @default(cuid())
  organizationId   String
  code             String
  name             String
  category         String // IMPLEMENTATION | CONSULTING | ALLOCATION | AMS | ADVISORY | TRAINING | OTHER
  description      String?
  defaultModel     String?
  revenueAccountId String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  @@unique([organizationId, code])
}

model PipelineStage {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  order          Int
  probability    Int // %
  kind           String  @default("OPEN") // OPEN | WON | LOST
  active         Boolean @default(true)
}

model LossReason {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  active         Boolean @default(true)
}

model ProjectType {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  templateKey    String? // chave da biblioteca de modelos (src/domain/wbs-templates.ts)
  wbsTemplate    Json? // modelo próprio da organização (fases → itens); tem precedência sobre templateKey
  active         Boolean @default(true)
}

model TeamRole {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  active         Boolean @default(true)
}

model SeniorityLevel {
  id             String @id @default(cuid())
  organizationId String
  name           String
  order          Int
}

model Skill {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  category       String?
  active         Boolean @default(true)

  @@unique([organizationId, name])
}

// Tabela comercial com vigência
model PriceTable {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  validFrom      DateTime  @db.Date
  validTo        DateTime? @db.Date
  currency       String    @default("BRL")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
}

model PriceTableItem {
  id             String   @id @default(cuid())
  organizationId String
  priceTableId   String
  teamRoleId     String?
  seniorityId    String?
  serviceId      String?
  hourlyRate     Decimal  @db.Decimal(18, 4)
  // Custo padrão de referência para precificação (o custo real vem do profissional)
  referenceCost  Decimal? @db.Decimal(18, 4)
}

model ExpenseCategory {
  id                  String   @id @default(cuid())
  organizationId      String
  name                String
  accountId           String?
  reimbursableDefault Boolean  @default(true)
  billableDefault     Boolean  @default(false)
  maxAmount           Decimal? @db.Decimal(18, 2)
  active              Boolean  @default(true)
}

enum AccountType {
  REVENUE
  DEDUCTION
  DIRECT_COST
  OPERATING_EXPENSE
  FINANCIAL
  OTHER
}

// Plano de contas gerencial
model ManagerialAccount {
  id             String      @id @default(cuid())
  organizationId String
  code           String
  name           String
  type           AccountType
  parentId       String?
  systemKey      String? // conta usada pelas integrações internas (ex.: LABOR_COST)
  active         Boolean     @default(true)

  @@unique([organizationId, code])
  @@unique([organizationId, systemKey])
}

model PaymentTerm {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  // [{ days: 30, percent: "50.00" }, ...] — soma deve ser 100
  installments   Json
  active         Boolean @default(true)
}

model PaymentMethod {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  active         Boolean @default(true)
}

// Alçadas de aprovação
model ApprovalRule {
  id                 String   @id @default(cuid())
  organizationId     String
  companyId          String?
  docType            String // PROPOSAL | PURCHASE_ORDER | REQUISITION | EXPENSE | PAYABLE | MEASUREMENT | ALLOCATION_EXCEPTION | CONTRACT_AMENDMENT
  name               String
  minAmount          Decimal? @db.Decimal(18, 2)
  maxDiscountPct     Decimal? @db.Decimal(9, 4) // exige aprovação se desconto > valor
  minMarginPct       Decimal? @db.Decimal(9, 4) // exige aprovação se margem < valor
  requiredPermission String
  level              Int      @default(1)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
}

model ApprovalRequest {
  id                 String    @id @default(cuid())
  organizationId     String
  companyId          String?
  entity             String
  entityId           String
  ruleId             String?
  level              Int       @default(1)
  requiredPermission String
  reasons            String[]
  status             String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELED
  requestedById      String
  decidedById        String?
  decidedAt          DateTime? @db.Timestamptz(3)
  comment            String?
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)

  @@index([organizationId, status])
  @@index([organizationId, entity, entityId])
}

model SlaPolicy {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  calendarId       String?
  // Status que pausam o SLA
  pauseStatuses    String[]
  reopenWindowDays Int      @default(7)
  autoCloseDays    Int      @default(5)
  active           Boolean  @default(true)
}

model SlaTarget {
  id                String @id @default(cuid())
  organizationId    String
  policyId          String
  priority          String // P1 | P2 | P3 | P4
  responseMinutes   Int
  resolutionMinutes Int
  escalateAfterPct  Int    @default(80)

  @@unique([policyId, priority])
}

model DocumentTemplate {
  id             String  @id @default(cuid())
  organizationId String
  type           String // PROPOSAL | CONTRACT | BILLING_DOCUMENT | STATUS_REPORT
  name           String
  header         String?
  footer         String?
  body           String?
  active         Boolean @default(true)
}

model CustomFieldDef {
  id             String   @id @default(cuid())
  organizationId String
  entity         String // PARTY | PROJECT | CONTRACT | OPPORTUNITY | TICKET
  key            String
  label          String
  type           String // TEXT | NUMBER | DATE | BOOLEAN | SELECT
  options        String[]
  required       Boolean  @default(false)
  active         Boolean  @default(true)

  @@unique([organizationId, entity, key])
}

// Parâmetros fiscais informados e validados pelo responsável fiscal, com vigência.
// O sistema NÃO define alíquotas ou códigos por conta própria.
model FiscalServiceCode {
  id               String    @id @default(cuid())
  organizationId   String
  companyId        String
  serviceId        String
  municipalityCode String
  serviceCode      String
  description      String?
  issRatePct       Decimal?  @db.Decimal(9, 4)
  validFrom        DateTime  @db.Date
  validTo          DateTime? @db.Date
  validatedBy      String?
  validatedAt      DateTime? @db.Timestamptz(3)
}

model WithholdingRule {
  id             String    @id @default(cuid())
  organizationId String
  companyId      String?
  code           String // ex.: IRRF, PIS, COFINS, CSLL, INSS, ISS — conforme responsável fiscal
  name           String
  ratePct        Decimal   @db.Decimal(9, 4)
  minBaseAmount  Decimal?  @db.Decimal(18, 2)
  validFrom      DateTime  @db.Date
  validTo        DateTime? @db.Date
  validatedBy    String?
  active         Boolean   @default(true)
}

model IntegrationConfig {
  id             String   @id @default(cuid())
  organizationId String
  kind           String // EMAIL | CALENDAR | TEAMS | ESIGN | NFSE | BANK | ACCOUNTING | TICKETING | API
  provider       String
  environment    String   @default("SANDBOX") // SANDBOX | PRODUCTION
  enabled        Boolean  @default(false)
  // Referência ao segredo (nome da variável/cofre). Nunca o segredo em si.
  secretRef      String?
  settings       Json     @default("{}")
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@unique([organizationId, kind])
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  prefix         String
  keyHash        String    @unique
  scopes         String[]
  createdById    String
  lastUsedAt     DateTime? @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
}

// ----------------------------------------------------------------------------
// Cadastros básicos
// ----------------------------------------------------------------------------

// Parte: pessoa física ou jurídica que pode ser cliente, prospect, fornecedor e/ou parceiro.
model Party {
  id             String   @id @default(cuid())
  organizationId String
