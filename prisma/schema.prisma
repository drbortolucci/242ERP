  createdById    String
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([organizationId, number])
  @@unique([organizationId, sourceType, sourceId])
  @@index([organizationId, status, dueDate])
}

