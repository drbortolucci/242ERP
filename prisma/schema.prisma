model Payable {
  id             String    @id @default(cuid())
  organizationId String
  companyId      String
  number         String
  partyId        String?
  professionalId String?
  sourceType     String // SUPPLIER_INVOICE | EXPENSE_REIMBURSEMENT | EXPENSE_ADVANCE | RECURRING | SUPPLIER_ADVANCE | MANUAL | PAYROLL
  sourceId       String?
  projectId      String?
  costCenterId   String?
  accountId      String?
  issueDate      DateTime  @db.Date
  dueDate        DateTime  @db.Date
  competence     DateTime  @db.Date
