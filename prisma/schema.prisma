  @@unique([organizationId, idempotencyKey])
}

// Documento fiscal (NFS-e) — controlado pelo provedor fiscal
model FiscalDocument {
  id                String    @id @default(cuid())
  organizationId    String
  companyId         String
  docType           String    @default("NFSE") // NFSE (serviços) | NFE (mercadorias)
