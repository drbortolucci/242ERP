  withholdings      Json      @default("[]")
  netAmount         Decimal   @db.Decimal(18, 2)
  advanceApplied    Decimal   @default(0) @db.Decimal(18, 2)
  status            String    @default("ISSUED") // ISSUED | CANCELED
  fiscalStatus      String    @default("NOT_REQUESTED") // NOT_REQUESTED | PENDING | AUTHORIZED | REJECTED | CANCELED
  idempotencyKey    String
  paymentTermId     String?
  cancelReason      String?
  canceledAt        DateTime? @db.Timestamptz(3)
  createdById       String
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)

