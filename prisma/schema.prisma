  status            String   @default("OPEN") // OPEN | PARTIAL | PAID | CANCELED | WRITTEN_OFF
  description       String?
  accountId         String?
  collectionNotes   String?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

