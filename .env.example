# Copie para .env e ajuste. NUNCA versione .env com segredos reais.
# Ambiente: development | staging | production
APP_ENV=development
APP_URL=http://localhost:3000

# Banco de dados PostgreSQL
DATABASE_URL=postgresql://erp:erp_local_dev@localhost:5432/erp_dev
# Usado pelos testes de integração (banco descartável)
TEST_DATABASE_URL=postgresql://erp:erp_local_dev@localhost:5432/erp_test

# Segredo para assinar sessões/tokens. Gere com: openssl rand -hex 32
SESSION_SECRET=troque-este-valor-em-cada-ambiente

# Armazenamento de anexos (adaptador local). Em produção use volume persistente ou adaptador S3.
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# Provedores externos. "simulated" = simulação local identificada (nenhuma ação externa real).
EMAIL_PROVIDER=simulated
PAYMENT_PROVIDER=simulated
FISCAL_PROVIDER=simulated
# Segredo HMAC dos webhooks do provedor de assinatura (simulado em dev)
PAYMENT_WEBHOOK_SECRET=troque-este-valor
FISCAL_WEBHOOK_SECRET=troque-este-valor
BANKING_WEBHOOK_SECRET=troque-este-valor

# API pública: limite de requisições por chave por minuto
API_RATE_LIMIT_PER_MIN=600
